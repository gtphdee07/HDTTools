{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/scripts/verification_debt.py\" --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/scripts/long_command_guard.py\" --hook",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/scripts/destructive_command_guard.py\" --hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
