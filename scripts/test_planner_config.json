{
  "_comment": "Test contexts for scripts/test_planner.py (#60, #61). Context names follow CONTEXT-MAP.md. A context with a 'marker' is a pytest context; one with 'commands' runs shell commands. An interface's 'files' are its public surface; a change to one adds its 'tests' and forces its context's Major suite, and queues the contexts in 'shares_with' (downstream, #66; api-contract shares with none: Web no longer calls the API, ADR-0007). A context's 'depends_on' names the contexts it imports (a list, or a mapping to the file globs it really imports); a change to one queues the dependent. 'docs_globs' are docs-only files that plan nothing. 'debt' holds the limits scripts/verification_debt.py (#67) recommends a context-level catch-up run at: unverified files per context and days since the context was last verified (0 = off). Command templates take {rel} (path under the context root), {fqcn} (Kotlin class) and {file}. The non-Python commands are the ones #52 documents; change them here if #52 settles on others.",
  "dependency_files": ["pyproject.toml", "uv.lock"],
  "docs_globs": ["*.md", "docs/*", "ClaudePlans/*"],
  "scope": {"file_max_files": 2},
  "debt": {"level": "session", "max_files": 15, "max_age_days": 7},
  "slow": [
    {
      "name": "tooling",
      "triggers": [
        "scripts/*", "pyproject.toml",
        "tests/conftest.py", "tests/_test_command_helpers.py",
        "web/package.json", "workers/scan-proxy/package.json", "workers/scan-proxy/knip.json", "workers/scan-proxy/src/liveTokenCli.ts",
        "android/build.gradle.kts", "android/settings.gradle.kts", "android/app/build.gradle.kts"
      ],
      "tests": ["tests/test_test_planner.py", "tests/test_context_test_commands.py", "tests/test_android_file_command_slow.py", "tests/test_scan_proxy_knip_config.py", "tests/test_scan_proxy_coverage_guard.py", "tests/test_static_checks_real.py"]
    },
    {
      "name": "ocr-photos",
      "triggers": [
        "src/hdttools/*_ocr.py", "src/hdttools/ocr_common.py", "src/hdttools/breakdown.py",
        "scripts/vehicle_discovery.py", "scripts/pass_pool.py", "scripts/fail_pool.py",
        "ExampleDocs/*"
      ],
      "tests": [
        "tests/test_real_photo_ocr_accuracy.py", "tests/test_scale_ticket_real_photo.py",
        "tests/test_pass_pool_regression.py", "tests/test_fail_pool_regression.py"
      ]
    },
    {
      "name": "streamlit-walkthrough",
      "triggers": ["streamlit_app/*", "src/hdttools/*_ocr.py", "src/hdttools/ocr_common.py", "ExampleDocs/*"],
      "tests": ["tests/test_streamlit_app.py"]
    },
    {
      "name": "breakdown-sweep",
      "triggers": ["src/hdttools/breakdown.py"],
      "tests": ["tests/test_breakdown_combinatorial_sweep.py"]
    }
  ],
  "contexts": {
    "core": {
      "marker": "core",
      "paths": ["src/hdttools/", "scripts/"],
      "live_globs": ["tests/test_*_external.py"],
      "session_end": "uv run scripts/static_checks.py core",
      "session_end_coverage": "uv run scripts/static_checks.py core --coverage",
      "session_end_runs_tests": false,
      "static_triggers": ["tests/*", "vulture_whitelist.py", "vulture_whitelist_tests.py", "ruff.toml"],
      "file": "uv run pytest {file}",
      "test_for": ["tests/test_{stem}.py"],
      "context": "uv run pytest -n auto -m \"core and not slow\"",
      "application": "uv run pytest -n auto -m \"not slow and not external\""
    },
    "streamlit": {
      "marker": "streamlit",
      "paths": ["streamlit_app/"],
      "depends_on": {"core": ["src/hdttools/*"]},
      "session_end": "uv run scripts/static_checks.py streamlit",
      "session_end_coverage": "uv run scripts/static_checks.py streamlit --coverage",
      "session_end_runs_tests": false,
      "static_triggers": ["vulture_whitelist.py", "ruff.toml"],
      "file": "uv run pytest {file}",
      "test_for": ["tests/test_{stem}.py", "tests/test_streamlit_app.py"],
      "context": "uv run pytest -m \"streamlit and not slow\"",
      "application": "uv run pytest -n auto -m \"not slow and not external\""
    },
    "web": {
      "paths": ["web/"],
      "platform": "web",
      "dependency_files": ["web/package.json", "web/package-lock.json"],
      "session_end": "uv run scripts/static_checks.py web",
      "session_end_runs_tests": false,
      "static_triggers": ["scripts/static_checks.py", "scripts/static_allowlists/*"],
      "test_globs": ["web/src/*.test.ts", "web/src/*.test.tsx"],
      "live_globs": ["web/src/external/*"],
      "commands": {"minor": "npm --prefix web test", "major": "npm --prefix web test"},
      "file": "npm --prefix web test -- {rel}",
      "test_for": ["{dir}/{stem}.test.ts", "{dir}/{stem}.test.tsx"],
      "context": "npm --prefix web test",
      "gate": "uv run scripts/external_freshness.py --platform web",
      "external": "powershell web/test-external.ps1"
    },
    "scan-proxy": {
      "paths": ["workers/scan-proxy/"],
      "platform": "scan-proxy",
      "dependency_files": ["workers/scan-proxy/package.json", "workers/scan-proxy/package-lock.json"],
      "session_end": "uv run scripts/static_checks.py scan-proxy",
      "session_end_runs_tests": false,
      "static_triggers": ["scripts/static_checks.py", "scripts/static_allowlists/*", "scripts/coverage_gate.py"],
      "test_globs": ["workers/scan-proxy/src/*.test.ts"],
      "live_globs": ["workers/scan-proxy/src/external/*", "workers/scan-proxy/src/weekly/*", "workers/scan-proxy/src/release/*"],
      "commands": {"minor": "npm --prefix workers/scan-proxy run test:sanity", "major": "npm --prefix workers/scan-proxy test"},
      "file": "node --test workers/scan-proxy/{rel}",
      "test_for": ["{dir}/{stem}.test.ts"],
      "context": "npm --prefix workers/scan-proxy test",
      "external": "powershell workers/scan-proxy/test-external.ps1",
      "release": [
        {"command": "npm --prefix workers/scan-proxy test", "reason": "Major suite (offline)"},
        {"command": "powershell workers/scan-proxy/test-weekly.ps1", "reason": "old weekly suite (live, paid)", "confirm": true},
        {"command": "powershell workers/scan-proxy/test-release.ps1", "reason": "old release suite (live, paid)", "confirm": true}
      ]
    },
    "android": {
      "paths": ["android/"],
      "platform": "android",
      "dependency_files": ["android/gradle/libs.versions.toml", "android/app/build.gradle.kts", "android/build.gradle.kts"],
      "test_globs": ["android/app/src/test/*"],
      "device_covered": [
        "android/app/src/main/java/com/rigcheck/app/ui/*",
        "android/app/src/main/java/com/rigcheck/app/MainActivity.kt",
        "android/app/src/main/AndroidManifest.xml",
        "android/app/src/androidTest/*"
      ],
      "device_free": [
        "android/app/src/main/java/com/rigcheck/app/ui/Scan*.kt",
        "android/app/src/main/java/com/rigcheck/app/ui/format/*",
        "android/app/src/androidTest/*WeeklyTest.kt",
        "android/app/src/androidTest/*ExternalTest.kt"
      ],
      "live_globs": ["android/app/src/androidTest/*ExternalTest.kt"],
      "device_full": [
        "android/app/src/main/java/com/rigcheck/app/ui/navigation/RigCheckNavHost.kt",
        "android/app/src/main/java/com/rigcheck/app/ui/RigCheckViewModel.kt",
        "android/app/src/main/java/com/rigcheck/app/MainActivity.kt",
        "android/app/src/main/AndroidManifest.xml"
      ],
      "device_classes": {
        "command": "android/gradlew -p android connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class={fqcn}",
        "map": [
          {"from": "android/app/src/main/java/com/rigcheck/app/ui/screens/*Screen.kt",
           "test": "android/app/src/androidTest/java/com/rigcheck/app/ui/screens/{stem}Test.kt"},
          {"from": "android/app/src/main/java/com/rigcheck/app/ui/components/*.kt",
           "test": "android/app/src/androidTest/java/com/rigcheck/app/ui/components/{stem}Test.kt"},
          {"from": "android/app/src/androidTest/*Test.kt", "test": "{file}"}
        ]
      },
      "commands": {"minor": "android/gradlew -p android testDebugUnitTest", "major": "android/gradlew -p android testDebugUnitTest"},
      "device": "android/gradlew -p android connectedDebugAndroidTest",
      "session_end": "uv run scripts/android_session_end.py",
      "external": "powershell android/test-external.ps1",
      "file": "android/gradlew -p android testDebugUnitTest --tests {fqcn}",
      "test_for": ["{dir}/{stem}Test.kt"],
      "dir_rewrite": ["src/main/", "src/test/"],
      "context": "android/gradlew -p android testDebugUnitTest",
      "release": [
        {"command": "android/gradlew -p android testDebugUnitTest", "reason": "JVM tests"},
        {"command": "android/gradlew -p android connectedDebugAndroidTest", "reason": "instrumented tests (needs a device)"},
        {"command": "powershell android/test-weekly.ps1", "reason": "old weekly suite (live, paid)", "confirm": true}
      ]
    }
  },
  "interfaces": [
    {
      "name": "ocr-output-keys",
      "context": "core",
      "files": ["src/hdttools/*_ocr.py", "streamlit_app/fields.py"],
      "tests": ["tests/test_ocr_output_key_contracts.py"],
      "shares_with": ["streamlit"]
    },
    {
      "name": "breakdown-golden-vectors",
      "context": "core",
      "files": ["src/hdttools/breakdown.py", "test-vectors/breakdown_cases.json", "web/src/breakdown.ts", "android/app/src/main/java/com/rigcheck/app/domain/*"],
      "tests": ["tests/test_breakdown_golden_vectors.py"],
      "shares_with": ["android", "web"],
      "shares_tests": {
        "web": "npm --prefix web test -- src/breakdown.test.ts",
        "android": "android/gradlew -p android testDebugUnitTest --tests com.rigcheck.app.domain.BreakdownGoldenVectorTest"
      }
    },
    {
      "name": "reader-entry-points",
      "context": "core",
      "files": ["src/hdttools/__init__.py", "src/hdttools/truck_tag.py", "src/hdttools/trailer_tag.py", "src/hdttools/scale_ticket.py"],
      "tests": ["tests/test_readers_integration.py"],
      "shares_with": ["streamlit"]
    },
    {
      "name": "vision-fixtures",
      "context": "core",
      "files": [
        "test-vectors/vision_external_cases.json",
        "test-vectors/vision_tool_schemas.json",
        "scripts/vision_cases.py",
        "workers/scan-proxy/src/docTypes.ts",
        "workers/scan-proxy/src/visionCases.ts"
      ],
      "tests": ["tests/test_vision_shared_fixtures.py", "tests/test_ocr_output_key_contracts.py", "tests/test_scan_form_fields_fixture.py"],
      "shares_with": ["scan-proxy", "web", "android"],
      "shares_tests": {
        "scan-proxy": "node --test workers/scan-proxy/src/visionSharedFixtures.test.ts",
        "web": "npm --prefix web test -- src/visionToolSchema.test.ts",
        "android": "android/gradlew -p android testDebugUnitTest --tests com.rigcheck.app.data.ScanFieldKeysSchemaTest"
      }
    },
    {
      "name": "scan-form-fields",
      "context": "core",
      "files": ["test-vectors/scan_form_fields.json"],
      "tests": ["tests/test_scan_form_fields_fixture.py"],
      "shares_with": ["web", "android"],
      "shares_tests": {
        "web": "npm --prefix web test -- src/scanFormFields.test.ts",
        "android": "android/gradlew -p android testDebugUnitTest --tests com.rigcheck.app.data.ScanFormFieldsFixtureTest"
      }
    },
    {
      "name": "scan-proxy-http",
      "context": "scan-proxy",
      "files": ["workers/scan-proxy/src/index.ts", "workers/scan-proxy/src/request.ts", "workers/scan-proxy/src/types.ts"],
      "tests": [],
      "shares_with": ["android"]
    },
    {
      "name": "scan-outcomes",
      "context": "scan-proxy",
      "files": [
        "test-vectors/scan_outcomes.json",
        "web/src/api.ts",
        "web/src/scanError.ts",
        "web/src/scanNotice.ts",
        "web/src/scanAttempts.ts",
        "android/app/src/main/java/com/rigcheck/app/ui/Scan*.kt",
        "android/app/src/main/java/com/rigcheck/app/data/ScanAttempts.kt"
      ],
      "tests": [],
      "shares_with": ["web", "android"],
      "shares_tests": {
        "web": "npm --prefix web test -- src/scanOutcomes.test.ts",
        "android": "android/gradlew -p android testDebugUnitTest --tests com.rigcheck.app.ui.ScanOutcomesFixtureTest"
      }
    }
  ]
}
