{
  "name": "rigcheck-scan-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test src/*.test.ts",
    "test:sanity": "node --test --test-name-pattern=\"\\[sanity\\]\" src/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage src/*.test.ts",
    "test:report": "node --test --test-reporter=junit --test-reporter-destination=test-results/junit-major.xml src/*.test.ts",
    "test:report:sanity": "node --test --test-reporter=junit --test-reporter-destination=test-results/junit-minor.xml --test-name-pattern=\"\\[sanity\\]\" src/*.test.ts",
    "pretest:weekly": "npm run typecheck && npm run deploy",
    "test:weekly": "node --test src/weekly/*.test.ts",
    "test:release": "node --test src/release/*.test.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
