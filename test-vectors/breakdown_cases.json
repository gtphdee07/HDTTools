    {
      "name": "rounding_half_way_values_round_up",
      "requires": [],
      "_note": "Rounding-edge case: every row has a value sitting exactly on a .5 boundary (all exactly representable in binary floating point, so no implementation can disagree because of float noise). The agreed answer is round-half-UP (ties toward positive infinity), matching Kotlin's roundToInt/roundToLong and JavaScript's Math.round. Python's built-in round() is half-to-even and would give 5000 / 6000 / 16000 / 26000 / 32000 for the .5 readings below and 12 / 62 for the pct ties - breakdown.py rounds half-up explicitly to match (ADR-0007). Rows: Front Axle pct is exactly 12.5 (1000/8000); Rear Axle actual is 5000.5; Tow Vehicle Total actual is 6000.5 and its limit is 16000.5; Trailer Axle pct is exactly 62.5 (5000/8000); Trailer Total is 10000 / 16000 = exactly 62.5 (pin_weight_pct 0.5 makes the axle-reading estimate exact); Combined Rig Weight actual is 26000.5 and its limit is 32000.5.",
      "truck": {"gvwr_lb": 16000.5, "front_gawr_lb": 8000, "rear_gawr_lb": 8000},
      "trailer": {"gvwr_lb": 16000, "gawr_per_axle_lb": 4000},
      "scale": {"steer_axle_lb": 1000, "drive_axle_lb": 5000.5, "trailer_axle_lb": 5000, "gross_weight_lb": 26000.5},
      "pin_weight_pct": 0.5,
      "expected": {
        "verdict_status": "pass",
        "items": [
          {"label": "Front Axle (Steer)", "tone": "success", "actual_lb": 1000, "limit_lb": 8000, "pct": 13, "estimated": false},
          {"label": "Rear Axle (Drive)", "tone": "success", "actual_lb": 5001, "limit_lb": 8000, "pct": 63, "estimated": false},
          {"label": "Tow Vehicle Total (GVWR)", "tone": "success", "actual_lb": 6001, "limit_lb": 16001, "pct": 38, "estimated": false},
          {"label": "Trailer Axle(s)", "tone": "success", "actual_lb": 5000, "limit_lb": 8000, "pct": 63, "estimated": false},
          {"label": "Trailer Total (GVWR)", "tone": "success", "actual_lb": 10000, "limit_lb": 16000, "pct": 63, "estimated": true},
          {"label": "Combined Rig Weight", "tone": "success", "actual_lb": 26001, "limit_lb": 32001, "pct": 81, "estimated": false}
